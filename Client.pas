    MicBoostBtn.BackColor := System.Drawing.Color.FromArgb(255, 193, 7)
  else
    MicBoostBtn.BackColor := System.Drawing.Color.FromArgb(60, 60, 65);
  
  if FSpkBoost then
    SpkBoostBtn.BackColor := System.Drawing.Color.FromArgb(255, 193, 7)
  else
    SpkBoostBtn.BackColor := System.Drawing.Color.FromArgb(60, 60, 65);
  
  main.DrawEQ(main.MicEQ, MicEQPanel);
  main.DrawEQ(main.SpkEQ, SpkEQPanel);
end;

