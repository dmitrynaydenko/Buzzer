procedure MainForm.AuthLoginClick(sender: Object; e: EventArgs);
var
  data: array of byte;
  buffer: array of byte;
  resp: string;
  usernameLocal: string;
  passwordLocal: string;
  remoteEP: IPEndPoint;
begin
  usernameLocal := AuthUsernameBox.Text;
  passwordLocal := AuthPasswordBox.Text;
  
  LogToFile('AuthLoginClick: username=' + usernameLocal);

  if (usernameLocal = '') or (passwordLocal = '') then
  begin
    AuthStatusLbl.Text := 'Enter username and password';
    LogToFile('AuthLogin: empty fields');
    Exit;
  end;

  try
    if VoiceClient <> nil then
    begin
      try VoiceClient.Close(); except end;
      VoiceClient := nil;
    end;

    VoiceClient := new UdpClient();
    VoiceClient.Client.ReceiveTimeout := 5000;
    ServerAddr := new IPEndPoint(IPAddress.Parse(AuthServerIP), SERVER_PORT);
    LogToFile('AuthLogin: VoiceClient created, ServerAddr=' + ServerAddr.ToString());

    data := Encoding.UTF8.GetBytes('LOGIN|' + usernameLocal + '|' + passwordLocal);
    VoiceClient.Send(data, data.Length, ServerAddr);
    LogToFile('AuthLogin: LOGIN sent');

    remoteEP := new IPEndPoint(IPAddress.Any, 0);
    buffer := VoiceClient.Receive(remoteEP);
    resp := Encoding.UTF8.GetString(buffer);
    LogToFile('AuthLogin: response=' + resp);

    if resp.StartsWith('LOGIN_SUCCESS|') then
    begin
      Username := usernameLocal;
      IsAuthenticated := true;
      AuthStatusLbl.Text := 'Login successful';
      LogToFile('AuthLogin: SUCCESS');
      AuthForm.Close();
      StartVoiceConnection();
    end
    else
    begin
      IsAuthenticated := false;
      AuthStatusLbl.Text := resp;
      LogToFile('AuthLogin: FAILED - ' + resp);
      try VoiceClient.Close(); except end;
      VoiceClient := nil;
    end;
  except
    on ex: Exception do
    begin
      IsAuthenticated := false;
      AuthStatusLbl.Text := 'Login error: ' + ex.Message;
      LogError('AuthLogin: ' + ex.Message);
      if VoiceClient <> nil then
      begin
        try VoiceClient.Close(); except end;
        VoiceClient := nil;
      end;
    end;
  end;
end;

