procedure MainForm.CaptureBtnClick(sender: Object; e: EventArgs);
begin
  LogToFile('CaptureBtnClick, isScreenCapturing=' + BoolToText(IsScreenCapturing));
  
  if not IsVoiceActive then
  begin
    SetStatusText('Status: Connect first');
    Exit;
  end;
  
  IsScreenCapturing := not IsScreenCapturing;
  
  if IsScreenCapturing then
    StartScreenCapture()
  else
    StopScreenCapture();
end;

procedure MainForm.StartScreenCapture();
var
  localPort: integer;
  statusData: array of byte;
begin
  LogToFile('StartScreenCapture');
  
  try
    // Создаем сокет для отправки видео
    if ScreenSendClient = nil then
    begin
      ScreenSendClient := new UdpClient();
      ScreenSendClient.EnableBroadcast := true;
      LogToFile('ScreenSendClient created');
    end;
    
    // Получаем порт, на котором слушает ScreenReceiveClient
    if ScreenReceiveClient <> nil then
    begin
      localPort := (ScreenReceiveClient.Client.LocalEndPoint as IPEndPoint).Port;
    end
    else
    begin
      localPort := 0;
      LogToFile('StartScreenCapture: ScreenReceiveClient is nil!');
    end;
    
    IsScreenCapturing := true;
    CaptureBtn.Text := 'STOP';
    CaptureBtn.BackColor := System.Drawing.Color.FromArgb(220, 53, 69);
    
    // Отправляем статус с портом
    statusData := Encoding.UTF8.GetBytes('SCREEN_START|' + Username + '|' + IntToStr(localPort));
    VoiceClient.Send(statusData, statusData.Length, ServerAddr);
    LogToFile('SCREEN_START sent via voice channel, screen_port=' + IntToStr(localPort));
    
    // Даем серверу время обработать
    Thread.Sleep(100);
    
    ScreenViewingUser := '';
    ViewBtn.Text := 'VIEW';
    ViewBtn.BackColor := System.Drawing.Color.FromArgb(108, 117, 125);
    
    ClearScreenView();
    SetStatusText('Status: Screen capture started (preview in center panel)');
    
    ScreenCaptureThread := new Thread(ScreenCaptureLoop);
    ScreenCaptureThread.IsBackground := true;
    ScreenCaptureThread.Start();
    LogToFile('ScreenCaptureThread started');
    
  except
    on ex: Exception do
    begin
      IsScreenCapturing := false;
      CaptureBtn.Text := 'CAPTURE';
      CaptureBtn.BackColor := System.Drawing.Color.FromArgb(40, 167, 69);
      SetStatusText('Status: Screen capture error: ' + ex.Message);
      LogError('StartScreenCapture: ' + ex.Message);
    end;
  end;
end;

procedure MainForm.StopScreenCapture();
begin
  LogToFile('StopScreenCapture');
  
  IsScreenCapturing := false;
  
  if ScreenCaptureThread <> nil then
  begin
    try ScreenCaptureThread.Join(1000); except end;
    ScreenCaptureThread := nil;
  end;
  
  try
    // Отправляем статус через ГОЛОСОВОЙ канал (VoiceClient)
    if VoiceClient <> nil then
    begin
      var statusData := Encoding.UTF8.GetBytes('SCREEN_STOP|' + Username);
      VoiceClient.Send(statusData, statusData.Length, ServerAddr);
      LogToFile('SCREEN_STOP sent via voice channel');
    end;
  except
    on ex: Exception do
      LogError('StopScreenCapture send: ' + ex.Message);
  end;
  
  CaptureBtn.Text := 'CAPTURE';
  CaptureBtn.BackColor := System.Drawing.Color.FromArgb(40, 167, 69);
  ClearScreenView();
  SetStatusText('Status: Screen capture stopped');
end;

procedure MainForm.ScreenCaptureLoop();
var
  bmp: Bitmap;
  captureRect: Rectangle;
  g: Graphics;
  startTime: DateTime;
  frameInterval: integer;
  tempBmp: Bitmap;
  scaledWidth: integer;
  scaledHeight: integer;
  displayBmp: Bitmap;
  frameCount: integer;
begin
  frameCount := 0;
  captureRect := new Rectangle(0, 0, ScreenWidth, ScreenHeight);
  
  var scaleX := SCREEN_TARGET_WIDTH / ScreenWidth;
  var scaleY := SCREEN_TARGET_HEIGHT / ScreenHeight;
  var scale := Math.Min(scaleX, scaleY);
  
  scaledWidth := Round(ScreenWidth * scale);
  scaledHeight := Round(ScreenHeight * scale);
  
  frameInterval := 1000 div SCREEN_CAPTURE_FPS;
  
  LogToFile('ScreenCaptureLoop started, target=' + IntToStr(scaledWidth) + 'x' + IntToStr(scaledHeight));
  
  while IsScreenCapturing do
  begin
    startTime := DateTime.Now;
    
    try
      bmp := new Bitmap(captureRect.Width, captureRect.Height, PixelFormat.Format32bppArgb);
      
      g := Graphics.FromImage(bmp);
      g.CopyFromScreen(0, 0, 0, 0, captureRect.Size);
      g.Dispose();
      
      if (scaledWidth < ScreenWidth) or (scaledHeight < ScreenHeight) then
      begin
        tempBmp := new Bitmap(bmp, scaledWidth, scaledHeight);
        bmp.Dispose();
        bmp := tempBmp;
      end;
      
      SendScreenFrame(bmp);
      
      displayBmp := new Bitmap(bmp);
      ShowScreenFrame(displayBmp);
      
      bmp.Dispose();
      
      frameCount := frameCount + 1;
      if frameCount mod 30 = 0 then
        LogToFile('ScreenCapture: ' + IntToStr(frameCount) + ' frames sent');
      
      var elapsed := (DateTime.Now - startTime).TotalMilliseconds;
      if elapsed < frameInterval then
        Thread.Sleep(Round(frameInterval - elapsed));
        
    except
      on ex: Exception do
      begin
        IsScreenCapturing := false;
        CaptureBtn.Text := 'CAPTURE';
        CaptureBtn.BackColor := System.Drawing.Color.FromArgb(40, 167, 69);
        SetStatusText('Status: Screen capture error: ' + ex.Message);
        LogError('ScreenCaptureLoop: ' + ex.Message);
        Break;
      end;
    end;
  end;
  
  LogToFile('ScreenCaptureLoop finished, total frames=' + IntToStr(frameCount));
end;

// ыауаыауыаоыщшуаоуыщаоыщауршащыуарщыаоауыщаоуыщ
// ПРОСТОЙ SendScreenFrame - БЕЗ СЖАТИЯ
// ыауаыауыаоыщшуаоуыщаоыщауршащыуарщыаоауыщаоуыщ

procedure MainForm.SendScreenFrame(bmp: Bitmap);
var
  ms: MemoryStream;
  data: array of byte;
  totalPackets: integer;
  packetIndex: integer;
  offset: integer;
  chunkSize: integer;
  currentChunkSize: integer;
  chunk: array of byte;
  base64: string;
  msg: string;
  sendData: array of byte;
  i: integer;
  ScreenServerAddr: IPEndPoint;
  currentFrame: integer;
begin
  try
    // Сохраняем как PNG
    ms := new MemoryStream();
    bmp.Save(ms, ImageFormat.Png);
    data := ms.ToArray();
    ms.Dispose();
    
    // Всегда делим на 4 части
    totalPackets := 4;
    chunkSize := (Length(data) + totalPackets - 1) div totalPackets;
    
    ScreenServerAddr := new IPEndPoint(ServerAddr.Address, SCREEN_PORT);
    
    // Увеличиваем номер кадра ОДИН раз для всего кадра
    FrameCounter := FrameCounter + 1;
    currentFrame := FrameCounter;
    
    for packetIndex := 0 to totalPackets - 1 do
    begin
      offset := packetIndex * chunkSize;
      if packetIndex = totalPackets - 1 then
        currentChunkSize := Length(data) - offset
      else
        currentChunkSize := chunkSize;
      
      // Проверяем, чтобы не выйти за границы
      if offset >= Length(data) then
        currentChunkSize := 0;
      
      SetLength(chunk, currentChunkSize);
      for i := 0 to currentChunkSize - 1 do
        chunk[i] := data[offset + i];
      
      base64 := Convert.ToBase64String(chunk);
      msg := 'SCREEN_DATA|' + Username + '|' + IntToStr(currentFrame) + '|' + 
             IntToStr(totalPackets) + '|' + IntToStr(packetIndex) + '|' + base64;
      sendData := Encoding.UTF8.GetBytes(msg);
      
      if ScreenSendClient <> nil then
        ScreenSendClient.Send(sendData, sendData.Length, ScreenServerAddr);
      
      // Небольшая задержка между пакетами для надежности
      if totalPackets > 1 then
        Thread.Sleep(5);
    end;
    
    // Логируем размер
    if currentFrame mod 10 = 0 then
      LogToFile('SendScreenFrame: frame ' + IntToStr(currentFrame) + ', ' + IntToStr(totalPackets) + ' packets, size=' + IntToStr(Length(data)) + ' bytes');
    
  except
    on ex: Exception do
      LogError('SendScreenFrame: ' + ex.Message);
  end;
end;

// ыауаыауыаоыщшуаоуыщаоыщауршащыуарщыаоауыщаоуыщ
// ПРИЕМ ТРАНСЛЯЦИЙ ЭКРАНА
// ыауаыауыаоыщшуаоуыщаоыщауршащыуарщыаоауыщаоуыщ

procedure MainForm.ReceiveScreenFrames();
var
  remoteEP: IPEndPoint;
  inData: array of byte;
  msg: string;
  parts: array of string;
  user: string;
  bmp: Bitmap;
  ms: MemoryStream;
  data: array of byte;
  frameCount: integer;
  totalPackets: integer;
  packetIndex: integer;
  packetData: array of byte;
  dictKey: string;
  PacketBuffer: Dictionary<string, array of byte>;
  PacketCounts: Dictionary<string, integer>;
  ExpectedPackets: Dictionary<string, integer>;
  PacketTimes: Dictionary<string, DateTime>;
  i: integer;
  now: DateTime;
  keyList: array of string;
begin
  frameCount := 0;
  remoteEP := new IPEndPoint(IPAddress.Any, 0);
  PacketBuffer := new Dictionary<string, array of byte>;
  PacketCounts := new Dictionary<string, integer>;
  ExpectedPackets := new Dictionary<string, integer>;
  PacketTimes := new Dictionary<string, DateTime>;
  
  LogToFile('ReceiveScreenFrames started, listening on port ' + IntToStr((ScreenReceiveClient.Client.LocalEndPoint as IPEndPoint).Port));
  
  while IsVoiceActive do
  begin
    try
      if ScreenReceiveClient = nil then
      begin
        LogToFile('ReceiveScreenFrames: ScreenReceiveClient is nil!');
        Break;
      end;
      
      ScreenReceiveClient.Client.ReceiveTimeout := 100;
      
      try
        inData := ScreenReceiveClient.Receive(remoteEP);
      except
        on ex: Exception do
        begin
          // Проверяем старые кадры (таймаут 2 секунды)
          now := DateTime.Now;
          keyList := PacketTimes.Keys.ToArray;
          for i := 0 to keyList.Length - 1 do
          begin
            if (now - PacketTimes[keyList[i]]).TotalSeconds > 2 then
            begin
              if frameCount mod 10 = 0 then
                LogToFile('ReceiveScreenFrames: TIMEOUT for ' + keyList[i] + ' (received ' + IntToStr(PacketCounts[keyList[i]]) + '/' + IntToStr(ExpectedPackets[keyList[i]]) + ' packets)');
              PacketBuffer.Remove(keyList[i]);
              PacketCounts.Remove(keyList[i]);
              ExpectedPackets.Remove(keyList[i]);
              PacketTimes.Remove(keyList[i]);
            end;
          end;
          Continue;
        end;
      end;
      
      if (inData = nil) or (inData.Length = 0) then Continue;
      
      frameCount := frameCount + 1;
      if frameCount mod 50 = 0 then
        LogToFile('ReceiveScreenFrames: received ' + IntToStr(frameCount) + ' packets total');
      
      try
        msg := Encoding.UTF8.GetString(inData);
        
        if msg.StartsWith('SCREEN_DATA|') then
        begin
          parts := msg.Split('|');
          if parts.Length >= 6 then
          begin
            user := parts[1];
            var frameNum := parts[2];
            totalPackets := StrToInt(parts[3]);
            packetIndex := StrToInt(parts[4]);
            packetData := Convert.FromBase64String(parts[5]);
            
            dictKey := user + '_' + frameNum;
            
            if not PacketBuffer.ContainsKey(dictKey) then
            begin
              PacketBuffer[dictKey] := new byte[0];
              PacketCounts[dictKey] := 0;
              ExpectedPackets[dictKey] := totalPackets;
              PacketTimes[dictKey] := DateTime.Now;
              
              if frameCount mod 10 = 0 then
                LogToFile('ReceiveScreenFrames: NEW frame ' + frameNum + ' from ' + user + ', total=' + IntToStr(totalPackets));
            end;
            
            PacketTimes[dictKey] := DateTime.Now;
            
            var currentData := PacketBuffer[dictKey];
            var newData := new byte[currentData.Length + packetData.Length];
            for i := 0 to currentData.Length - 1 do
              newData[i] := currentData[i];
            for i := 0 to packetData.Length - 1 do
              newData[currentData.Length + i] := packetData[i];
            PacketBuffer[dictKey] := newData;
            PacketCounts[dictKey] := PacketCounts[dictKey] + 1;
            
            if frameCount mod 20 = 0 then
              LogToFile('ReceiveScreenFrames: frame ' + frameNum + ' packet ' + IntToStr(packetIndex+1) + '/' + IntToStr(totalPackets) + ' received');
            
            if PacketCounts[dictKey] = ExpectedPackets[dictKey] then
            begin
              data := PacketBuffer[dictKey];
              
              if frameCount mod 10 = 0 then
                LogToFile('ReceiveScreenFrames: frame ' + frameNum + ' COMPLETE! Size=' + IntToStr(Length(data)) + ' bytes');
              
              if (ScreenViewingUser = user) and (not IsScreenCapturing) then
              begin
                try
                  ms := new MemoryStream(data);
                  bmp := new Bitmap(ms);
                  ms.Dispose();
                  ShowScreenFrame(bmp);
                  
                  if frameCount mod 10 = 0 then
                    LogToFile('ReceiveScreenFrames: frame ' + frameNum + ' DISPLAYED! (' + IntToStr(bmp.Width) + 'x' + IntToStr(bmp.Height) + ')');
                except
                  on ex: Exception do
                    LogError('ReceiveScreenFrames: failed to create bitmap - ' + ex.Message);
                end;
              end;
              
              PacketBuffer.Remove(dictKey);
              PacketCounts.Remove(dictKey);
              ExpectedPackets.Remove(dictKey);
              PacketTimes.Remove(dictKey);
            end;
          end;
        end;
      except
        on ex: Exception do
          LogError('ReceiveScreenFrames parse: ' + ex.Message);
      end;
    except
      on ex: Exception do
        if frameCount mod 50 = 0 then
          LogError('ReceiveScreenFrames receive: ' + ex.Message);
    end;
  end;
  
  LogToFile('ReceiveScreenFrames finished, total frames=' + IntToStr(frameCount));
end;


