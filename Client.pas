procedure MainForm.StartVoiceConnection();
var
  fmt: WaveFormat;
  screenPort: integer;
begin
  LogToFile('StartVoiceConnection started');
  
  if VoiceClient = nil then
  begin
    SetStatusText('Status: Voice socket is not initialized');
    LogToFile('StartVoiceConnection: VoiceClient is nil');
    Exit;
  end;

  fmt := new WaveFormat(AUDIO_SAMPLE_RATE, AUDIO_BITS, AUDIO_CHANNELS);

  MicInput := new WaveInEvent();
  MicInput.WaveFormat := fmt;
  MicInput.BufferMilliseconds := 20;
  MicInput.NumberOfBuffers := 3;
  MicInput.DataAvailable += SendVoice;

  AudioBuffer := new BufferedWaveProvider(fmt);
  AudioBuffer.DiscardOnBufferOverflow := true;

  SpeakerOutput := new WaveOutEvent();
  SpeakerOutput.Init(AudioBuffer);
  SpeakerOutput.Volume := 1.0;

  IsVoiceActive := true;
  MonitorMode := false;
  CurrentRoom := 1;
  MicLevel := 0;
  SpkLevel := 0;
  PacketsSent := 0;
  PacketsReceived := 0;

  HighlightCurrentRoom();
  GlobalChatMemo.Clear();
  RoomChatMemo.Clear();

  MicInput.StartRecording();
  LogToFile('StartVoiceConnection: Mic started');
  
  SpeakerOutput.Play();
  LogToFile('StartVoiceConnection: Speaker started');

  RecvThread := new Thread(ReceiveVoice);
  RecvThread.IsBackground := true;
  RecvThread.Start();
  LogToFile('StartVoiceConnection: RecvThread started');

  HeartbeatThread := new Thread(HeartbeatLoop);
  HeartbeatThread.IsBackground := true;
  HeartbeatThread.Start();
  LogToFile('StartVoiceConnection: HeartbeatThread started');

  //  СОЗДАЕМ ScreenReceiveClient НА ДИНАМИЧЕСКОМ ПОРТУ 
  if ScreenReceiveClient = nil then
  begin
    ScreenReceiveClient := new UdpClient();
    ScreenReceiveClient.Client.Bind(new IPEndPoint(IPAddress.Any, 0));
    screenPort := (ScreenReceiveClient.Client.LocalEndPoint as IPEndPoint).Port;
    LogToFile('StartVoiceConnection: ScreenReceiveClient bound to dynamic port ' + IntToStr(screenPort));
  end;
  
  //  ЗАПУСКАЕМ ПОТОК ПРИЕМА ВИДЕО 
  ScreenReceiveThread := new Thread(ReceiveScreenFrames);
  ScreenReceiveThread.IsBackground := true;
  ScreenReceiveThread.Start();
  LogToFile('StartVoiceConnection: ScreenReceiveThread started');

  ConnectBtn.Enabled := false;
  DisconnectBtn.Enabled := true;
  ScanBtn.Enabled := false;
  CaptureBtn.Enabled := true;
  ViewBtn.Enabled := true;

  MonitorBtn.BackColor := System.Drawing.Color.FromArgb(108, 117, 125);
  MonitorStatusLbl.Text := 'Monitor: OFF';

  SetStatusText('Status: Connected as ' + Username);
  LogToFile('StartVoiceConnection: SUCCESS, connected as ' + Username);
end;


procedure MainForm.DisconnectVoice();
begin
  LogToFile('DisconnectVoice started');
  
  if IsScreenCapturing then
    StopScreenCapture();
  
  IsVoiceActive := false;
  IsAuthenticated := false;
  MonitorMode := false;
  ScreenViewingUser := '';
  
  ViewBtn.Text := 'VIEW';
  ViewBtn.BackColor := System.Drawing.Color.FromArgb(108, 117, 125);
  ClearScreenView();

  if MicInput <> nil then
  begin
    try MicInput.StopRecording(); except end;
    MicInput := nil;
  end;

  if SpeakerOutput <> nil then
  begin
    try SpeakerOutput.Stop(); except end;
    SpeakerOutput := nil;
  end;

  if VoiceClient <> nil then
  begin
    try VoiceClient.Close(); except end;
    VoiceClient := nil;
  end;

  if ScreenSendClient <> nil then
  begin
    try ScreenSendClient.Close(); except end;
    ScreenSendClient := nil;
  end;

  if ScreenReceiveClient <> nil then
  begin
    try ScreenReceiveClient.Close(); except end;
    ScreenReceiveClient := nil;
  end;

  AudioBuffer := nil;

  if RecvThread <> nil then
  begin
    try RecvThread.Join(500); except end;
    RecvThread := nil;
  end;

  if HeartbeatThread <> nil then
  begin
    try HeartbeatThread.Join(500); except end;
    HeartbeatThread := nil;
  end;

  if ScreenReceiveThread <> nil then
  begin
    try ScreenReceiveThread.Join(500); except end;
    ScreenReceiveThread := nil;
  end;

  if ScreenCaptureThread <> nil then
  begin
    try ScreenCaptureThread.Join(500); except end;
    ScreenCaptureThread := nil;
  end;

  UserScreenStatus.Clear();
  UsersListBox.Items.Clear();
  CurrentRoom := 1;
  HighlightCurrentRoom();

  ConnectBtn.Enabled := true;
  DisconnectBtn.Enabled := false;
  ScanBtn.Enabled := true;
  CaptureBtn.Enabled := false;
  ViewBtn.Enabled := false;
  CaptureBtn.Text := 'CAPTURE';
  CaptureBtn.BackColor := System.Drawing.Color.FromArgb(40, 167, 69);

  MonitorBtn.BackColor := System.Drawing.Color.FromArgb(108, 117, 125);
  MonitorStatusLbl.Text := 'Monitor: OFF';

  GlobalChatMemo.Clear();
  RoomChatMemo.Clear();

  SetStatusText('Status: Disconnected');
  LogToFile('DisconnectVoice finished');
end;

procedure MainForm.SwitchRoom(roomID: integer);
var
  data: array of byte;
begin
  if not IsVoiceActive then Exit;
  if not IsAuthenticated then Exit;
  if (roomID < 1) or (roomID > MAX_ROOMS) then Exit;
  if roomID = CurrentRoom then Exit;

  data := Encoding.UTF8.GetBytes('ROOM_CHANGE|' + IntToStr(roomID));
  VoiceClient.Send(data, data.Length, ServerAddr);

  if roomID = MUTE_ROOM_ID then
    SetStatusText('Status: Switching to MUTE room')
  else
    SetStatusText('Status: Switching to room ' + IntToStr(roomID));
  
  LogToFile('SwitchRoom: to ' + IntToStr(roomID));
end;

// ыауаыауыаоыщшуаоуыщаоыщауршащыуарщыаоауыщаоуыщ
// ПРИЕМ ГОЛОСА
// ыауаыауыаоыщшуаоуыщаоыщауршащыуарщыаоауыщаоуыщ

procedure MainForm.ReceiveVoice();
var
  remoteEP: IPEndPoint;
  inData: array of byte;
  msg: string;
  parts: array of string;
  userArray: array of string;
  newRoom: integer;
  i: integer;
  lineText: string;
  historyText: string;
  pongData: array of byte;
  packetCount: integer;
begin
  packetCount := 0;
  remoteEP := new IPEndPoint(IPAddress.Any, 0);
  
  LogToFile('ReceiveVoice started');

  while IsVoiceActive do
  begin
    try
      if VoiceClient = nil then Break;

      inData := VoiceClient.Receive(remoteEP);
      if (inData = nil) or (inData.Length = 0) then Continue;

      packetCount := packetCount + 1;
      if packetCount mod 50 = 0 then
        LogToFile('ReceiveVoice: ' + IntToStr(packetCount) + ' packets received');

      // Если пакет маленький и содержит текст - это команда
      if inData.Length <= 8192 then
      begin
        try
          msg := Encoding.UTF8.GetString(inData);

          // PING
          if msg = 'PING' then
          begin
            pongData := Encoding.UTF8.GetBytes('PONG');
            VoiceClient.Send(pongData, pongData.Length, ServerAddr);
            Continue;
          end;

          if msg = 'PLAY_ALL_SOUND' then
          begin
            PlayAllSound();
            Continue;
          end;

          // ВСЕ КОМАНДЫ ОБРАБАТЫВАЕМ И ДЕЛАЕМ CONTINUE
          if msg.StartsWith('SCREEN_START|') then
          begin
            parts := msg.Split('|');
            if parts.Length >= 2 then
            begin
              var user := parts[1];
              UserScreenStatus[user] := true;
              LogToFile('ReceiveVoice: SCREEN_START from ' + user);
              UpdateUserListStatus();
            end;
            Continue;
          end;

          if msg.StartsWith('SCREEN_STOP|') then
          begin
            parts := msg.Split('|');
            if parts.Length >= 2 then
            begin
              var user := parts[1];
              UserScreenStatus[user] := false;
              LogToFile('ReceiveVoice: SCREEN_STOP from ' + user);
              UpdateUserListStatus();
              
              if ScreenViewingUser = user then
              begin
                ScreenViewingUser := '';
                ViewBtn.Text := 'VIEW';
                ViewBtn.BackColor := System.Drawing.Color.FromArgb(108, 117, 125);
                ClearScreenView();
                SetStatusText('Status: ' + user + ' stopped sharing');
              end;
            end;
            Continue;
          end;

          if msg.StartsWith('USER_LIST|') then
          begin
            parts := msg.Split('|');
            if parts.Length >= 2 then
            begin
              userArray := parts[1].Split(',');
              SetLength(PendingUserList, userArray.Length);
              for i := 0 to userArray.Length - 1 do
                PendingUserList[i] := userArray[i];
              PendingUserListReady := true;
              LogToFile('ReceiveVoice: USER_LIST received, count=' + IntToStr(userArray.Length));
            end;
            Continue;
          end;

          if msg.StartsWith('ROOM_CHANGED|') then
          begin
            parts := msg.Split('|');
            if (parts.Length >= 2) and Integer.TryParse(parts[1], newRoom) then
            begin
              PendingRoomID := newRoom;
              PendingRoomChanged := true;

              if newRoom = MUTE_ROOM_ID then
                PendingStatusText := 'Status: Switched to MUTE room'
              else
                PendingStatusText := 'Status: Switched to room ' + IntToStr(newRoom);

              PendingStatusReady := true;
              LogToFile('ReceiveVoice: ROOM_CHANGED to ' + IntToStr(newRoom));
            end;
            Continue;
          end;

          if msg.StartsWith('CHAT_HISTORY_GLOBAL|') then
          begin
            parts := msg.Split('|');
            if parts.Length >= 2 then
            begin
              historyText := DecodeTextBase64(parts[1]);
              PendingGlobalReplace := historyText;
              PendingGlobalReplaceReady := true;
              LogToFile('ReceiveVoice: CHAT_HISTORY_GLOBAL received');
            end;
            Continue;
          end;

          if msg.StartsWith('CHAT_HISTORY_ROOM|') then
          begin
            parts := msg.Split('|');
            if parts.Length >= 3 then
            begin
              historyText := DecodeTextBase64(parts[2]);
              PendingRoomReplace := historyText;
              PendingRoomReplaceReady := true;
              LogToFile('ReceiveVoice: CHAT_HISTORY_ROOM received');
            end;
            Continue;
          end;

          if msg.StartsWith('CHAT_GLOBAL|') then
          begin
            parts := msg.Split('|');
            if parts.Length >= 4 then
            begin
              lineText := DecodeTextBase64(parts[1]) + ' | ' + DecodeTextBase64(parts[2]) + ': ' + DecodeTextBase64(parts[3]);
              PendingGlobalAppend.Add(lineText + Environment.NewLine);
            end;
            Continue;
          end;

          if msg.StartsWith('CHAT_ROOM|') then
          begin
            parts := msg.Split('|');
            if parts.Length >= 5 then
            begin
              lineText := DecodeTextBase64(parts[2]) + ' | ' + DecodeTextBase64(parts[3]) + ': ' + DecodeTextBase64(parts[4]);
              PendingRoomAppend.Add(lineText + Environment.NewLine);
            end;
            Continue;
          end;
          
          // Если это команда, но мы ее не распознали - все равно пропускаем
          if (msg.Length > 0) and (msg[1] >= 'A') and (msg[1] <= 'Z') then
            Continue;
            
        except
          // Если не удалось преобразовать в строку - это голос
        end;
      end;

      // СЮДА ПОПАДАЮТ ТОЛЬКО ГОЛОСОВЫЕ ПАКЕТЫ
      if CurrentRoom = MUTE_ROOM_ID then
      begin
        SpkLevel := 0;
        Continue;
      end;

      // Добавляем голосовые данные в аудио буфер
      SetLength(RawSpkBuffer, inData.Length);
      for i := 0 to inData.Length - 1 do
        RawSpkBuffer[i] := inData[i];

      ApplyGain16(inData, SpkGain);
      SpkLevel := CalcPeak16(inData);
      UpdateEQFromData(RawSpkBuffer, SpkEQ, PrevSpkLevels);

      if AudioBuffer <> nil then
      begin
        AudioBuffer.AddSamples(inData, 0, inData.Length);
        PacketsReceived := PacketsReceived + 1;
      end;
    except
      on ex: Exception do
        LogError('ReceiveVoice loop: ' + ex.Message);
    end;
  end;
  
  LogToFile('ReceiveVoice finished, total packets=' + IntToStr(packetCount));
end;

// ыауаыауыаоыщшуаоуыщаоыщауршащыуарщыаоауыщаоуыщ
// HEARTBEAT - отправляем PONG каждые 3 секунды
// ыауаыауыаоыщшуаоуыщаоыщауршащыуарщыаоауыщаоуыщ

procedure MainForm.HeartbeatLoop();
var
  data: array of byte;
  pingCount: integer;
begin
  pingCount := 0;
  LogToFile('HeartbeatLoop started');
  
  while IsVoiceActive do
  begin
    Thread.Sleep(3000);
    try
      if VoiceClient <> nil then
      begin
        data := Encoding.UTF8.GetBytes('PONG');
        VoiceClient.Send(data, data.Length, ServerAddr);
        pingCount := pingCount + 1;
        if pingCount mod 10 = 0 then
          LogToFile('HeartbeatLoop: ' + IntToStr(pingCount) + ' PONG sent');
      end;
    except
      on ex: Exception do
        LogError('HeartbeatLoop: ' + ex.Message);
    end;
  end;
  
  LogToFile('HeartbeatLoop finished, total PONG=' + IntToStr(pingCount));
end;

// ыауаыауыаоыщшуаоуыщаоыщауршащыуарщыаоауыщаоуыщ
// ОТПРАВКА ГОЛОСА
// ыауаыауыаоыщшуаоуыщаоыщауршащыуарщыаоауыщаоуыщ

procedure MainForm.SendVoice(sender: Object; e: WaveInEventArgs);
var
  outData: array of byte;
  i: integer;
  framePeak: integer;
  fftData: array of Complex;
  sample: SmallInt;
  window: Double;
  spectrumSize: integer;
  rmsLevel: Double;
  rmsPercent: integer;
begin
  if not IsVoiceActive then Exit;
  if not IsAuthenticated then Exit;
  if e.BytesRecorded <= 0 then Exit;

  if CurrentRoom = MUTE_ROOM_ID then
  begin
    MicLevel := 0;
    Exit;
  end;

  SetLength(outData, e.BytesRecorded);
  SetLength(RawMicBuffer, e.BytesRecorded);

  for i := 0 to e.BytesRecorded - 1 do
  begin
    outData[i] := e.Buffer[i];
    RawMicBuffer[i] := e.Buffer[i];
  end;

  spectrumSize := e.BytesRecorded div 2;
  if spectrumSize > FFT_SIZE then
    spectrumSize := FFT_SIZE;
    
  if spectrumSize >= 64 then
  begin
    SetLength(fftData, FFT_SIZE);
    
    for i := 0 to FFT_SIZE - 1 do
    begin
      if i < spectrumSize then
      begin
        sample := SmallInt((Integer(e.Buffer[i*2 + 1]) shl 8) or e.Buffer[i*2]);
        window := 0.5 * (1 - Cos(2 * PI * i / (FFT_SIZE - 1)));
        fftData[i].Re := sample * window / 32768.0;
        fftData[i].Im := 0;
      end
      else
      begin
        fftData[i].Re := 0;
        fftData[i].Im := 0;
      end;
    end;
    
    FFT(fftData, false);
    
    rmsLevel := 0.0;
    for i := 0 to spectrumSize - 1 do
    begin
      sample := SmallInt((Integer(e.Buffer[i*2 + 1]) shl 8) or e.Buffer[i*2]);
      rmsLevel := rmsLevel + Sqr(sample);
    end;
    if spectrumSize > 0 then
      rmsLevel := Sqrt(rmsLevel / spectrumSize);
    
    rmsPercent := Round((rmsLevel / 32767) * 100);
    
    if rmsPercent < 2 then
    begin
      for i := 0 to Min((FFT_SIZE div 2) - 1, Length(NoiseProfileData) - 1) do
      begin
        var currentMag := Magnitude(fftData[i]) * 2.0;
        if currentMag > 1.0 then currentMag := 1.0;
        
        NoiseProfileData[i] := NoiseProfileData[i] * 0.95 + currentMag * 0.05;
      end;
      
      for i := 1 to Min((FFT_SIZE div 2) - 2, Length(NoiseProfileData) - 2) do
        NoiseProfileData[i] := (NoiseProfileData[i-1] + NoiseProfileData[i] + NoiseProfileData[i+1]) / 3;
      
      NoiseLearnCounter := NoiseLearnCounter + 1;
      if NoiseLearnCounter >= NOISE_LEARN_FRAMES then
        NoiseProfileReady := true;
    end
    else
    begin
      if NoiseLearnCounter > 0 then
        NoiseLearnCounter := 0;
    end;
  end;

  if NoiseThreshold > 0 then
    ApplyNoiseGate16(outData, NoiseThreshold);
    
  ApplyGain16(outData, MicGain);

  framePeak := CalcPeak16(outData);
  MicLevel := framePeak;
  UpdateEQFromData(RawMicBuffer, MicEQ, PrevMicLevels);

  if framePeak < 1 then Exit;

  if MonitorMode then
  begin
    if AudioBuffer <> nil then
      AudioBuffer.AddSamples(outData, 0, outData.Length);
  end
  else
  begin
    try
      if VoiceClient <> nil then
      begin
        VoiceClient.Send(outData, outData.Length, ServerAddr);
        PacketsSent := PacketsSent + 1;
      end;
    except
    end;
  end;
end;

// ыауаыауыаоыщшуаоуыщаоыщауршащыуарщыаоауыщаоуыщ
// ШУМОПОДАВЛЕНИЕ
// ыауаыауыаоыщшуаоуыщаоыщауршащыуарщыаоауыщаоуыщ

procedure MainForm.ApplyNoiseGate16(var data: array of byte; thresholdPercent: integer);
var
  i: integer;
  sample: SmallInt;
  window: Double;
  mag: Double;
  noiseThreshold: Double;
  fftData: array of Complex;
  halfSize: integer;
  readPos: integer;
  outPos: integer;
  rmsLevel: Double;
  speechPresent: boolean;
  suppression: Double;
begin
  if Length(data) = 0 then Exit;
  if not NoiseProfileReady then Exit;
  
  if Length(AccumBuffer) = 0 then
  begin
    SetLength(AccumBuffer, FFT_SIZE * 2);
    AccumPos := 0;
    AccumSize := 0;
  end;
  
  halfSize := FFT_SIZE div 2;
  
  for i := 0 to (Length(data) div 2) - 1 do
  begin
    sample := SmallInt((Integer(data[i*2 + 1]) shl 8) or data[i*2]);
    AccumBuffer[AccumPos] := sample;
    AccumPos := (AccumPos + 1) mod Length(AccumBuffer);
    if AccumSize < Length(AccumBuffer) then
      AccumSize := AccumSize + 1;
  end;
  
  for i := 0 to Length(data) - 1 do
    data[i] := 0;
  
  outPos := 0;
  
  while AccumSize >= FFT_SIZE do
  begin
    SetLength(fftData, FFT_SIZE);
    
    readPos := (AccumPos - FFT_SIZE + Length(AccumBuffer)) mod Length(AccumBuffer);
    for i := 0 to FFT_SIZE - 1 do
    begin
      sample := AccumBuffer[readPos];
      readPos := (readPos + 1) mod Length(AccumBuffer);
      
      window := 0.5 * (1 - Cos(2 * PI * i / (FFT_SIZE - 1)));
      fftData[i].Re := sample * window / 32768.0;
      fftData[i].Im := 0;
    end;
    
    FFT(fftData, false);
    
    rmsLevel := 0;
    for i := 0 to halfSize - 1 do
    begin
      mag := Magnitude(fftData[i]);
      rmsLevel := rmsLevel + mag * mag;
    end;
    rmsLevel := Sqrt(rmsLevel / halfSize);
    
    speechPresent := (rmsLevel > 0.008);
    
    for i := 0 to FFT_SIZE - 1 do
    begin
      mag := Magnitude(fftData[i]);
      
      if mag < 0.0000001 then
      begin
        fftData[i].Re := 0;
        fftData[i].Im := 0;
        Continue;
      end;
      
      if i < halfSize then
        noiseThreshold := NoiseProfileData[i] * 0.7
      else
        noiseThreshold := 0.001;
      
      if speechPresent then
      begin
        if mag < noiseThreshold * 2.0 then
        begin
          if mag < noiseThreshold then
            suppression := 0.02
          else
            suppression := 0.3;
        end
        else
        begin
          suppression := 1 - (noiseThreshold * 1.1 / mag);
          if suppression < 0.1 then suppression := 0.1;
          if suppression > 1.0 then suppression := 1.0;
        end;
      end
      else
      begin
        if mag < noiseThreshold * 3.0 then
          suppression := 0.01
        else
          suppression := max(0.01, 1 - (noiseThreshold * 1.3 / mag));
      end;
      
      suppression := suppression * 0.7 + PrevSuppression[i] * 0.3;
      
      if suppression < 0.02 then suppression := 0.02;
      
      PrevSuppression[i] := suppression;
      
      fftData[i].Re := fftData[i].Re * suppression;
      fftData[i].Im := fftData[i].Im * suppression;
    end;
    
    FFT(fftData, true);
    
    for i := 0 to FFT_SIZE - 1 do
    begin
      sample := Round(fftData[i].Re * 32768.0);
      if sample > 32767 then sample := 32767;
      if sample < -32768 then sample := -32768;
      TempBuffer[i] := sample;
    end;
    
    for i := 0 to halfSize - 1 do
    begin
      TempBuffer[i] := (TempBuffer[i] + OverlapBuffer[i]) div 2;
    end;
    
    for i := 0 to halfSize - 1 do
      OverlapBuffer[i] := TempBuffer[i + halfSize];
    
    for i := 0 to halfSize - 1 do
    begin
      if outPos < Length(data) div 2 then
      begin
        sample := TempBuffer[i];
        data[outPos*2] := Byte(sample and $FF);
        data[outPos*2+1] := Byte((sample shr 8) and $FF);
        outPos := outPos + 1;
      end;
    end;
    
    AccumSize := AccumSize - halfSize;
  end;
end;

// ыауаыауыаоыщшуаоуыщаоыщауршащыуарщыаоауыщаоуыщ
// FFT ФУНКЦИИ
// ыауаыауыаоыщшуаоуыщаоыщауршащыуарщыаоауыщаоуыщ

function MainForm.BitReverse(n: integer; bits: integer): integer;
var
  rev: integer;
  i: integer;
begin
  rev := 0;
  for i := 0 to bits - 1 do
  begin
    rev := (rev shl 1) or (n and 1);
    n := n shr 1;
  end;
  Result := rev;
end;

procedure MainForm.FFT(var data: array of Complex; invert: boolean);
var
  n: integer;
  bits: integer;
  i, j, k: integer;
  len: integer;
  angle: Double;
  w: Complex;
  temp: Complex;
  wlen_re, wlen_im: Double;
begin
  n := Length(data);
  if n = 0 then Exit;
  
  bits := 0;
  while (1 shl bits) < n do
    bits := bits + 1;
  
  for i := 0 to n - 1 do
  begin
    j := BitReverse(i, bits);
    if i < j then
    begin
      temp := data[i];
      data[i] := data[j];
      data[j] := temp;
    end;
  end;
  
  len := 2;
  while len <= n do
  begin
    angle := 2 * PI / len;
    if invert then
      angle := -angle;
    
    for i := 0 to n - 1 do
    begin
      if i mod len <> 0 then Continue;
      
      w.Re := 1;
      w.Im := 0;
      
      wlen_re := Cos(angle);
      wlen_im := Sin(angle);
      
      for j := 0 to len div 2 - 1 do
      begin
        temp.Re := w.Re * data[i + j + len div 2].Re - w.Im * data[i + j + len div 2].Im;
        temp.Im := w.Re * data[i + j + len div 2].Im + w.Im * data[i + j + len div 2].Re;
        
        data[i + j + len div 2].Re := data[i + j].Re - temp.Re;
        data[i + j + len div 2].Im := data[i + j].Im - temp.Im;
        
        data[i + j].Re := data[i + j].Re + temp.Re;
        data[i + j].Im := data[i + j].Im + temp.Im;
        
        temp.Re := w.Re * wlen_re - w.Im * wlen_im;
        temp.Im := w.Re * wlen_im + w.Im * wlen_re;
        w := temp;
      end;
    end;
    len := len shl 1;
  end;
  
  if invert then
    for i := 0 to n - 1 do
    begin
      data[i].Re := data[i].Re / n;
      data[i].Im := data[i].Im / n;
    end;
end;

function MainForm.Magnitude(c: Complex): Double;
begin
  Result := Sqrt(c.Re * c.Re + c.Im * c.Im);
end;

// ыауаыауыаоыщшуаоуыщаоыщауршащыуарщыаоауыщаоуыщ
// ВСПОМОГАТЕЛЬНЫЕ ПРОЦЕДУРЫ
// ыауаыауыаоыщшуаоуыщаоыщауршащыуарщыаоауыщаоуыщ

procedure MainForm.ApplyGain16(var data: array of byte; gain: real);
var
  i: integer;
  value: integer;
  sample: smallint;
begin
  i := 0;
  while i + 1 < Length(data) do
  begin
    sample := smallint((integer(data[i + 1]) shl 8) or integer(data[i]));
    value := Round(integer(sample) * gain);

    if value > 32767 then value := 32767;
    if value < -32768 then value := -32768;

    data[i] := byte(value and $FF);
    data[i + 1] := byte((value shr 8) and $FF);
    i := i + 2;
  end;
end;

function MainForm.CalcPeak16(data: array of byte): integer;
var
  i: integer;
  value: integer;
  peak: integer;
  sample: smallint;
begin
  peak := 0;
  i := 0;
  while i + 1 < Length(data) do
  begin
    sample := smallint((integer(data[i + 1]) shl 8) or integer(data[i]));
    value := Abs(integer(sample));
    if value > peak then peak := value;
    i := i + 2;
  end;

  Result := peak * 100 div 32767;
  if Result > 100 then Result := 100;
end;

procedure MainForm.UpdateEQFromData(data: array of byte; var eqBands: array of EQBand; var prevLevels: array of integer);
var
  sampleCount: integer;
  bandsCount: integer;
  bandSize: integer;
  i: integer;
  j: integer;
  bytePos: integer;
  maxLevel: integer;
  val: integer;
  sample16: smallint;
  smoothing: real;
begin
  bandsCount := Length(eqBands);
  if bandsCount = 0 then Exit;

  sampleCount := Length(data) div 2;
  if sampleCount = 0 then Exit;

  bandSize := sampleCount div bandsCount;
  if bandSize < 1 then bandSize := 1;

  smoothing := 0.6;

  for j := 0 to bandsCount - 1 do
  begin
    maxLevel := 0;

    for i := j * bandSize to (j + 1) * bandSize - 1 do
    begin
      if i >= sampleCount then Break;
      bytePos := i * 2;
      if bytePos + 1 >= Length(data) then Break;

      sample16 := smallint((integer(data[bytePos + 1]) shl 8) or integer(data[bytePos]));
      val := Abs(integer(sample16)) * 100 div 32768;
      if val > 100 then val := 100;
      if val > maxLevel then maxLevel := val;
    end;

    eqBands[j].Level := maxLevel;

    if prevLevels[j] > 0 then
      eqBands[j].Level := Round(eqBands[j].Level * (1 - smoothing) + prevLevels[j] * smoothing);

    prevLevels[j] := eqBands[j].Level;

    if eqBands[j].Level > eqBands[j].Peak then
      eqBands[j].Peak := eqBands[j].Level;

    if eqBands[j].Peak > 0 then
      eqBands[j].Peak := eqBands[j].Peak - 1;
  end;
end;

procedure MainForm.SetStatusText(text: string);
begin
  StatusLbl.Text := text;
end;

procedure MainForm.ApplyPendingUserList();
begin
  if not PendingUserListReady then Exit;
  PendingUserListReady := false;
  UpdateUserListStatus();
end;

procedure MainForm.ApplyPendingRoom();
begin
  if not PendingRoomChanged then Exit;

  CurrentRoom := PendingRoomID;
  HighlightCurrentRoom();
  PendingRoomChanged := false;

  if CurrentRoom = MUTE_ROOM_ID then
  begin
    MicLevel := 0;
    SpkLevel := 0;
    if AudioBuffer <> nil then
      AudioBuffer.ClearBuffer();
    MonitorMode := false;
    MonitorBtn.BackColor := System.Drawing.Color.FromArgb(108, 117, 125);
    MonitorStatusLbl.Text := 'Monitor: OFF';
  end;

  if PendingStatusReady then
  begin
    StatusLbl.Text := PendingStatusText;
    PendingStatusReady := false;
  end;
end;

procedure MainForm.ApplyPendingChat();
var
  i: integer;
begin
  if PendingGlobalReplaceReady then
  begin
    GlobalChatMemo.Text := PendingGlobalReplace;
    GlobalChatMemo.SelectionStart := GlobalChatMemo.TextLength;
    GlobalChatMemo.ScrollToCaret();
    PendingGlobalReplaceReady := false;
  end;

  if PendingRoomReplaceReady then
  begin
    RoomChatMemo.Text := PendingRoomReplace;
    RoomChatMemo.SelectionStart := RoomChatMemo.TextLength;
    RoomChatMemo.ScrollToCaret();
    PendingRoomReplaceReady := false;
  end;

  if PendingGlobalAppend.Count > 0 then
  begin
    for i := 0 to PendingGlobalAppend.Count - 1 do
      GlobalChatMemo.AppendText(PendingGlobalAppend[i]);
    PendingGlobalAppend.Clear();
    GlobalChatMemo.SelectionStart := GlobalChatMemo.TextLength;
    GlobalChatMemo.ScrollToCaret();
  end;

  if PendingRoomAppend.Count > 0 then
  begin
    for i := 0 to PendingRoomAppend.Count - 1 do
      RoomChatMemo.AppendText(PendingRoomAppend[i]);
    PendingRoomAppend.Clear();
    RoomChatMemo.SelectionStart := RoomChatMemo.TextLength;
    RoomChatMemo.ScrollToCaret();
  end;
end;

procedure MainForm.UpdateUI();
begin
  ApplyPendingChat();

  if CurrentRoom = MUTE_ROOM_ID then
    StatsLbl.Text := 'STATISTICS'#10'Sent: ' + IntToStr(PacketsSent) + #10'Received: ' + IntToStr(PacketsReceived) + #10'Room: MUTE'
  else
    StatsLbl.Text := 'STATISTICS'#10'Sent: ' + IntToStr(PacketsSent) + #10'Received: ' + IntToStr(PacketsReceived) + #10'Room: ' + IntToStr(CurrentRoom);

  if MicEQPanel <> nil then
    DrawEQ(MicEQ, MicEQPanel);
    
  if SpkEQPanel <> nil then
    DrawEQ(SpkEQ, SpkEQPanel);
end;

procedure MainForm.DrawEQ(eqBands: array of EQBand; panel: Panel);
var
  g: Graphics;
  bandWidth: integer;
  barHeight: integer;
  x: integer;
  i: integer;
  peakY: integer;
  brush: System.Drawing.SolidBrush;
  pen: System.Drawing.Pen;
begin
  if panel = nil then Exit;
  if Length(eqBands) = 0 then Exit;
  
  try
    g := panel.CreateGraphics();
    if g = nil then Exit;
    
    g.Clear(System.Drawing.Color.FromArgb(45, 45, 48));

    bandWidth := panel.Width div EQ_BANDS;
    if bandWidth < 3 then bandWidth := 3;

    for i := 0 to Length(eqBands) - 1 do
    begin
      x := i * bandWidth;
      barHeight := eqBands[i].Level * panel.Height div 100;

      if barHeight > 1 then
      begin
        if eqBands[i].Level > 70 then
          brush := new System.Drawing.SolidBrush(System.Drawing.Color.Red)
        else if eqBands[i].Level > 40 then
          brush := new System.Drawing.SolidBrush(System.Drawing.Color.Orange)
        else
          brush := new System.Drawing.SolidBrush(System.Drawing.Color.LimeGreen);

        g.FillRectangle(brush, x, panel.Height - barHeight, bandWidth - 1, barHeight);
        brush.Dispose();
      end;

      if eqBands[i].Peak > 0 then
      begin
        peakY := panel.Height - (eqBands[i].Peak * panel.Height div 100);
        pen := new System.Drawing.Pen(System.Drawing.Color.Yellow, 2);
        g.DrawLine(pen, x, peakY, x + bandWidth - 1, peakY);
        pen.Dispose();
      end;
    end;

    g.Dispose();
  except
  end;
end;

procedure MainForm.HighlightCurrentRoom();
var
  k: integer;
begin
  for k := 1 to MAX_ROOMS do
    RoomButtons[k].BackColor := System.Drawing.Color.FromArgb(60, 60, 65);

  if (CurrentRoom >= 1) and (CurrentRoom <= MAX_ROOMS) then
  begin
    if CurrentRoom = MUTE_ROOM_ID then
      RoomButtons[CurrentRoom].BackColor := System.Drawing.Color.FromArgb(220, 53, 69)
    else
      RoomButtons[CurrentRoom].BackColor := System.Drawing.Color.FromArgb(40, 167, 69);
  end;
end;

function MainForm.GetComputerNameByIP(ip: string): string;
var
  hostEntry: IPHostEntry;
begin
  Result := ip;
  try
    hostEntry := Dns.GetHostEntry(ip);
    if hostEntry <> nil then
      Result := hostEntry.HostName;
  except
  end;
end;

function MainForm.BoolToText(b: boolean): string;
begin
  if b then Result := 'ON' else Result := 'OFF';
end;

function MainForm.EncodeTextBase64(s: string): string;
begin
  Result := Convert.ToBase64String(Encoding.UTF8.GetBytes(s));
end;

function MainForm.DecodeTextBase64(s: string): string;
begin
  Result := Encoding.UTF8.GetString(Convert.FromBase64String(s));
end;

procedure MainForm.PlayAllSound();
var
  soundPath: string;
begin
  soundPath := System.IO.Path.Combine(System.IO.Directory.GetCurrentDirectory(), 'sound.mp3');

  if not System.IO.File.Exists(soundPath) then
  begin
    SetStatusText('Status: sound.mp3 not found next to client');
    Exit;
  end;

  try
    mciSendString('close notifysound', nil, 0, 0);
    mciSendString('open "' + soundPath + '" type mpegvideo alias notifysound', nil, 0, 0);
    mciSendString('play notifysound from 0', nil, 0, 0);
  except
    on ex: Exception do
      SetStatusText('Status: sound playback error: ' + ex.Message);
  end;
end;

