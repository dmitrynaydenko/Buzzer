procedure MainForm.ClearScreenView();
begin
  try
    if ScreenPictureBox.Image <> nil then
    begin
      try
        var oldBmp := ScreenPictureBox.Image as Bitmap;
        if oldBmp <> nil then
          oldBmp.Dispose();
      except
      end;
    end;
    ScreenPictureBox.Image := nil;
    ScreenPictureBox.Refresh();
  except
  end;
end;

procedure MainForm.ShowScreenFrame(bmp: Bitmap);
begin
  try
    if ScreenPictureBox.Image <> nil then
    begin
      try
        var oldBmp := ScreenPictureBox.Image as Bitmap;
        if oldBmp <> nil then
          oldBmp.Dispose();
      except
      end;
    end;
    
    ScreenPictureBox.Image := bmp;
    ScreenPictureBox.Refresh();
  except
    try bmp.Dispose(); except end;
  end;
end;

procedure MainForm.ShowUserScreen(user: string);
var
  localPort: integer;
  statusData: array of byte;
begin
  LogToFile('ShowUserScreen: ' + user);
  
  if user = '' then Exit;
  if user = Username then
  begin
    SetStatusText('Status: Cannot view your own screen');
    Exit;
  end;
  
  if IsScreenCapturing then
  begin
    SetStatusText('Status: Stop your capture first to view others');
    Exit;
  end;
  
  if not UserScreenStatus.ContainsKey(user) or not UserScreenStatus[user] then
  begin
    SetStatusText('Status: User ' + user + ' is not sharing screen');
    Exit;
  end;
  
  // Если уже смотрим этого пользователя - отключаем просмотр
  if ScreenViewingUser = user then
  begin
    ScreenViewingUser := '';
    ViewBtn.Text := 'VIEW';
    ViewBtn.BackColor := System.Drawing.Color.FromArgb(108, 117, 125);
    ClearScreenView();
    SetStatusText('Status: Stopped viewing');
    LogToFile('Stopped viewing ' + user);
    Exit;
  end;
  
  // ===== ВАЖНО: Сообщаем серверу наш порт для приема видео =====
  if ScreenReceiveClient <> nil then
  begin
    localPort := (ScreenReceiveClient.Client.LocalEndPoint as IPEndPoint).Port;
    // Отправляем команду с нашим портом, чтобы сервер знал, куда отправлять
    statusData := Encoding.UTF8.GetBytes('SCREEN_VIEW|' + Username + '|' + IntToStr(localPort));
    VoiceClient.Send(statusData, statusData.Length, ServerAddr);
    LogToFile('SCREEN_VIEW sent, screen_port=' + IntToStr(localPort));
  end
  else
  begin
    LogToFile('ShowUserScreen: ScreenReceiveClient is nil!');
    SetStatusText('Status: Error - no screen receiver');
    Exit;
  end;
  
  // Начинаем просмотр
  ScreenViewingUser := user;
  ViewBtn.Text := 'STOP VIEW';
  ViewBtn.BackColor := System.Drawing.Color.FromArgb(255, 193, 7);
  ClearScreenView();
  SetStatusText('Status: Viewing ' + user + ' screen');
  LogToFile('Started viewing ' + user);
end;

