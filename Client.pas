procedure MainForm.ConnectBtnClick(sender: Object; e: EventArgs);
var
  idx: integer;
  ipText: string;
  parsedIp: IPAddress;
begin
  LogToFile('ConnectBtnClick');
  
  ipText := ManualIpBox.Text.Trim();

  if ipText <> '' then
  begin
    if not IPAddress.TryParse(ipText, parsedIp) then
    begin
      SetStatusText('Status: Invalid manual IP');
      LogToFile('Invalid manual IP: ' + ipText);
      Exit;
    end;

    SelectedServerIP := parsedIp.ToString();
    LogToFile('Connecting to manual IP: ' + SelectedServerIP);
    ConnectToServer(SelectedServerIP);
    Exit;
  end;

  idx := ServersListBox.SelectedIndex;
  if (idx < 0) or (idx >= ServersList.Count) then
  begin
    SetStatusText('Status: Select a server or enter IP manually');
    LogToFile('No server selected');
    Exit;
  end;

  SelectedServerIP := ServersList[idx].IP;
  LogToFile('Connecting to selected server: ' + SelectedServerIP);
  ConnectToServer(SelectedServerIP);
end;

