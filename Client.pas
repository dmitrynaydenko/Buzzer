function MainForm.LoadIconFromBase64(base64Str: string): System.Drawing.Icon;
var
  data: array of byte;
  ms: MemoryStream;
begin
  Result := nil;
  try
    if base64Str = '' then
    begin
      LogToFile('LoadIconFromBase64: empty string');
      Exit;
    end;
    
    data := Convert.FromBase64String(base64Str);
    if Length(data) = 0 then
    begin
      LogToFile('LoadIconFromBase64: data is empty');
      Exit;
    end;
    
    ms := new MemoryStream(data);
    Result := new System.Drawing.Icon(ms);
    ms.Dispose();
    
    if Result <> nil then
      LogToFile('LoadIconFromBase64: icon loaded successfully')
    else
      LogToFile('LoadIconFromBase64: icon is nil');
    
  except
    on ex: Exception do
    begin
      LogToFile('LoadIconFromBase64 error: ' + ex.Message);
      Result := nil;
    end;
  end;
end;

