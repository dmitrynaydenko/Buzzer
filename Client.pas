//fsoifjeofsijesofsoifehsfoehfsofieshosfheiofshefoisfhefsf

procedure MainForm.InitState();
var
  i: integer;
  hDC: IntPtr;
begin
  LogToFile('InitState started');
  
  ServersList := new List<ServerInfo>;
  PendingGlobalAppend := new List<string>;
  PendingRoomAppend := new List<string>;

  SelectedServerIP := '';
  IsVoiceActive := false;
  IsAuthenticated := false;
  MonitorMode := false;
  IsScreenCapturing := false;
  IsScreenViewing := false;

  MicGain := 1.0;
  SpkGain := 1.0;
  NoiseThreshold := 0;
  MicBoost := false;
  SpkBoost := false;

  MicLevel := 0;
  SpkLevel := 0;
  PacketsSent := 0;
  PacketsReceived := 0;
  CurrentRoom := 1;
  Username := '';
  ScreenViewingUser := '';
  FrameCounter := 0;

  PendingUserListReady := false;
  PendingRoomChanged := false;
  PendingStatusReady := false;
  PendingGlobalReplaceReady := false;
  PendingRoomReplaceReady := false;
  PendingRoomID := 1;
  PendingGlobalReplace := '';
  PendingRoomReplace := '';
  AllowRealClose := false;

  SetLength(MicEQ, EQ_BANDS);
  SetLength(SpkEQ, EQ_BANDS);
  SetLength(PrevMicLevels, EQ_BANDS);
  SetLength(PrevSpkLevels, EQ_BANDS);

  for i := 0 to EQ_BANDS - 1 do
  begin
    MicEQ[i].Level := 0;
    MicEQ[i].Peak := 0;
    SpkEQ[i].Level := 0;
    SpkEQ[i].Peak := 0;
    PrevMicLevels[i] := 0;
    PrevSpkLevels[i] := 0;
  end;
  
  SetLength(NoiseProfileData, FFT_SIZE div 2);
  SetLength(AccumBuffer, FFT_SIZE * 2);
  SetLength(PrevSuppression, FFT_SIZE);
  SetLength(OverlapBuffer, FFT_OVERLAP);
  SetLength(TempBuffer, FFT_SIZE);
  
  for i := 0 to FFT_SIZE - 1 do
    PrevSuppression[i] := 1.0;
  
  for i := 0 to FFT_SIZE div 2 - 1 do
    NoiseProfileData[i] := 0.001;
  
  for i := 0 to FFT_OVERLAP - 1 do
    OverlapBuffer[i] := 0;
  
  AccumPos := 0;
  AccumSize := 0;
  NoiseProfileReady := false;
  NoiseLearnCounter := 0;
  
  // Инициализация захвата экрана
  UserScreenStatus := new Dictionary<string, boolean>;
  ScreenSendClient := nil;
  ScreenReceiveClient := nil;
  
  hDC := GetDC(IntPtr.Zero);
  if hDC <> IntPtr.Zero then
  begin
    ScreenWidth := GetDeviceCaps(hDC, DESKTOPHORZRES);
    ScreenHeight := GetDeviceCaps(hDC, DESKTOPVERTRES);
    ReleaseDC(IntPtr.Zero, hDC);
  end
  else
  begin
    ScreenWidth := Screen.PrimaryScreen.Bounds.Width;
    ScreenHeight := Screen.PrimaryScreen.Bounds.Height;
  end;
  
  LogToFile('InitState finished, screen=' + IntToStr(ScreenWidth) + 'x' + IntToStr(ScreenHeight));
end;

