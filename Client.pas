procedure AudioSettingsForm.MicVolumeScroll(sender: Object; e: EventArgs);
begin
  FMicGain := MicVolumeSlider.Value / 100.0;
  if FMicBoost then
    FMicGain := FMicGain * 1.5;
  MicVolumeLbl.Text := IntToStr(MicVolumeSlider.Value) + '%';
end;

procedure AudioSettingsForm.SpkVolumeScroll(sender: Object; e: EventArgs);
begin
  FSpkGain := SpkVolumeSlider.Value / 100.0;
  if FSpkBoost then
    FSpkGain := FSpkGain * 1.5;
  SpkVolumeLbl.Text := IntToStr(SpkVolumeSlider.Value) + '%';
end;

procedure AudioSettingsForm.NoiseScroll(sender: Object; e: EventArgs);
begin
  FNoiseThreshold := NoiseSlider.Value;
  NoiseLbl.Text := IntToStr(NoiseSlider.Value) + '%';
end;

procedure AudioSettingsForm.MicBoostClick(sender: Object; e: EventArgs);
var
  main: MainForm;
begin
  FMicBoost := not FMicBoost;
  FMicGain := MicVolumeSlider.Value / 100.0;
  if FMicBoost then
    FMicGain := FMicGain * 1.5;
  
  main := MainFormRef as MainForm;
  main.SetStatusText('Status: Mic boost ' + main.BoolToText(FMicBoost));
end;

procedure AudioSettingsForm.SpkBoostClick(sender: Object; e: EventArgs);
var
  main: MainForm;
begin
  FSpkBoost := not FSpkBoost;
  FSpkGain := SpkVolumeSlider.Value / 100.0;
  if FSpkBoost then
    FSpkGain := FSpkGain * 1.5;
  
  main := MainFormRef as MainForm;
  main.SetStatusText('Status: Speaker boost ' + main.BoolToText(FSpkBoost));
end;

