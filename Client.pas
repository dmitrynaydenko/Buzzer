procedure MainForm.LogToFile(msg: string);
var
  sw: StreamWriter;
begin
  try
    lock LogLock do
    begin
      sw := new StreamWriter(LOG_FILE, true, System.Text.Encoding.UTF8);
      try
        sw.WriteLine(DateTime.Now.ToString('yyyy-MM-dd HH:mm:ss') + ' | ' + msg);
      finally
        sw.Close();
      end;
    end;
  except
  end;
end;

procedure MainForm.LogConnect(msg: string);
begin
  LogToFile('[CONNECT] ' + msg);
end;

procedure MainForm.LogError(msg: string);
begin
  LogToFile('[ERROR] ' + msg);
end;

