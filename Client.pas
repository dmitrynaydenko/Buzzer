procedure MainForm.DiscoverServers();
var
  udp: UdpClient;
  data: array of byte;
  msg: string;
  response: string;
  serverIP: string;
  remoteEP: IPEndPoint;
  startTime: DateTime;
  parts: array of string;
  server: ServerInfo;
  i: integer;
  exists: boolean;
begin
  LogToFile('DiscoverServers started');
  SetStatusText('Status: Scanning network');
  ServersList.Clear();
  ServersListBox.Items.Clear();
  SelectedServerIP := '';

  udp := new UdpClient();
  try
    udp.EnableBroadcast := true;
    msg := 'WHO_IS_THERE?';
    data := Encoding.UTF8.GetBytes(msg);
    udp.Send(data, data.Length, '255.255.255.255', DISCOVERY_PORT);

    remoteEP := new IPEndPoint(IPAddress.Any, 0);
    udp.Client.ReceiveTimeout := 500;
    startTime := DateTime.Now;

    while (DateTime.Now - startTime).TotalMilliseconds < DISCOVERY_TIMEOUT do
    begin
      try
        data := udp.Receive(remoteEP);
        response := Encoding.UTF8.GetString(data);

        if response.StartsWith('SERVER_HERE|') then
        begin
          parts := response.Split('|');
          if parts.Length >= 2 then
          begin
            serverIP := remoteEP.Address.ToString();
            exists := false;

            for i := 0 to ServersList.Count - 1 do
              if ServersList[i].IP = serverIP then
                exists := true;

            if not exists then
            begin
              server := new ServerInfo;
              server.IP := serverIP;
              server.Port := StrToInt(parts[1]);
              server.Name := GetComputerNameByIP(serverIP);

              ServersList.Add(server);
              ServersListBox.Items.Add(server.Name + ' (' + server.IP + ':' + IntToStr(server.Port) + ')');
              LogToFile('Found server: ' + server.Name + ' (' + server.IP + ':' + IntToStr(server.Port) + ')');
            end;
          end;
        end;
      except
      end;
    end;
  except
    on ex: Exception do
    begin
      SetStatusText('Status: Scan error: ' + ex.Message);
      LogError('DiscoverServers: ' + ex.Message);
    end;
  end;

  udp.Close();
  LogToFile('DiscoverServers finished, found=' + IntToStr(ServersList.Count));

  if ServersList.Count = 0 then
    SetStatusText('Status: No servers found')
  else
    SetStatusText('Status: Found ' + IntToStr(ServersList.Count) + ' server(s)');
end;

